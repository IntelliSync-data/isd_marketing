<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========================================== -->
    <!-- 6. REGISTRATION LEAD FORM SNIPPET          -->
    <!-- ========================================== -->
    <template id="s_tiw_registration" name="TIW Lead Registration Form">
        <section id="register" class="s_tiw_registration oe_snippet_body">
            <div class="container">
                <div class="row g-5 align-items-center">
                    <div class="col-lg-7">
                        <span class="tiw-badge-tag bg-tiw-orange mb-3"><i class="fa fa-gift"></i> Ưu Đãi Tuyển Sinh</span>
                        <h2 class="display-5 fw-bold mb-3">ĐĂNG KÝ NHẬN <span class="text-tiw-yellow">LỘ TRÌNH MIỄN PHÍ</span> &amp; TEST ĐẦU VÀO</h2>
                        <p class="lead text-white-50 mb-4">
                            Hãy để chuyên gia học thuật của The IELTS Workshop giúp bạn phân tích điểm mạnh, điểm yếu và xây dựng kế hoạch học tập tối ưu nhất!
                        </p>
                        <div class="d-flex flex-column gap-3 mb-4">
                            <div class="d-flex align-items-center gap-3">
                                <span class="badge bg-warning text-dark rounded-circle p-2"><i class="fa fa-check"></i></span>
                                <span>Bài kiểm tra 4 kỹ năng chuẩn format đề thi thật miễn phí.</span>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <span class="badge bg-warning text-dark rounded-circle p-2"><i class="fa fa-check"></i></span>
                                <span>Nhận học bổng giảm tới 15% học phí khi đăng ký sớm.</span>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <span class="badge bg-warning text-dark rounded-circle p-2"><i class="fa fa-check"></i></span>
                                <span>Tặng trọn bộ tài liệu độc quyền do thầy Đặng Trần Tùng biên soạn.</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="reg-card">
                            <!-- Success State -->
                            <div class="tiw-form-success d-none text-center py-4">
                                <div class="text-success fs-1 mb-2"><i class="fa fa-check-circle"></i></div>
                                <h4 class="fw-bold mb-2">ĐĂNG KÝ THÀNH CÔNG!</h4>
                                <p class="small text-muted mb-4">Chuyên viên học thuật của The IELTS Workshop sẽ liên hệ với bạn trong vòng 15 phút.</p>
                                <button type="button" class="tiw-btn-primary btn-sm btn-reset-form">Gửi lại thông tin khác</button>
                            </div>
                            <!-- Form State -->
                            <div class="tiw-form-active">
                                <h4 class="fw-bold mb-1">Điền Thông Tin Tư Vấn</h4>
                                <p class="small text-muted mb-3">Thông tin của bạn được bảo mật tuyệt đối 100%.</p>
                                <div class="alert alert-danger small d-none tiw-form-alert" role="alert"></div>
                                <form class="tiw-lead-form">
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-uppercase">Họ và tên *</label>
                                        <input type="text" name="name" required="required" placeholder="Ví dụ: Nguyễn Văn A" class="form-control rounded-3 py-2"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-uppercase">Số điện thoại *</label>
                                        <input type="tel" name="phone" required="required" placeholder="Ví dụ: 0912 345 678" class="form-control rounded-3 py-2"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-uppercase">Email</label>
                                        <input type="email" name="email" placeholder="email@example.com" class="form-control rounded-3 py-2"/>
                                    </div>
                                    <div class="row g-2 mb-3">
                                        <div class="col-6">
                                            <label class="form-label small fw-bold text-uppercase">Khu vực</label>
                                            <select name="city" class="form-select rounded-3 py-2">
                                                <option value="hanoi">Hà Nội</option>
                                                <option value="hcm">TP.HCM</option>
                                                <option value="online">Học Online</option>
                                            </select>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small fw-bold text-uppercase">Mục tiêu Band</label>
                                            <select name="target" class="form-select rounded-3 py-2">
                                                <option value="mất gốc">Từ mất gốc</option>
                                                <option value="5.5">Mục tiêu 5.5+</option>
                                                <option value="6.5" selected="selected">Mục tiêu 6.5+</option>
                                                <option value="7.5">Mục tiêu 7.5+</option>
                                            </select>
                                        </div>
                                    </div>
                                    <button type="submit" class="tiw-btn-primary w-100 py-3 mt-2">
                                        <i class="fa fa-paper-plane me-1"></i> ĐĂNG KÝ TƯ VẤN NGAY
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
