<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The home page the theme arrives with.

         The blocks are written out in full rather than t-called. A t-call
         renders the same page, but the Website Builder cannot edit through
         one, so the page would look right and refuse to be changed. Written
         out, this becomes the website's own copy of the home page when the
         theme is applied, and is edited like any other.

         Generated from views/snippets/*.xml by tools/theme_tool.py. The two
         are expected to drift: the snippets are what can be dropped, this is
         what was dropped. Changing a snippet does not, and should not, rewrite
         a home page someone has since edited. -->
    <template id="homepage" inherit_id="website.homepage" name="Theme The IELTS Workshop Home">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure">
<section class="s_tiw_hero oe_snippet_body">
            <img src="/theme_theieltsworkshop/static/src/img/test-trinh-do.jpg" class="hero-bg-img" alt="TIW Hero Background"/>
            <div class="hero-bg-overlay"/>
            <div class="container hero-slide">
                <div class="row align-items-center">
                    <div class="col-lg-7">
                        <div class="tiw-badge-tag bg-tiw-yellow text-tiw-dark mb-3">
                            <span class="d-inline-block rounded-circle bg-danger" style="width: 6px; height: 6px;"/>
                            Miễn Phí 100%
                        </div>
                        <h1 class="hero-title">KIỂM TRA TRÌNH ĐỘ MIỄN PHÍ</h1>
                        <p class="hero-subtitle">Đánh giá chính xác 4 kỹ năng chuẩn đề thi quốc tế</p>
                        <p class="text-white-50 fs-6 mb-4">
                            Nhận kết quả và tư vấn lộ trình học cá nhân hóa trực tiếp từ đội ngũ chuyên gia The IELTS Workshop.
                        </p>
                        <div class="row g-2 mb-4">
                            <div class="col-sm-6 hero-check-item">
                                <i class="fa fa-check-circle"/>
                                <span>Giáo viên 8.5 - 9.0 IELTS</span>
                            </div>
                            <div class="col-sm-6 hero-check-item">
                                <i class="fa fa-check-circle"/>
                                <span>Phương pháp L.I.M độc quyền</span>
                            </div>
                            <div class="col-sm-6 hero-check-item">
                                <i class="fa fa-check-circle"/>
                                <span>Chấm chữa bài chi tiết 1:1</span>
                            </div>
                            <div class="col-sm-6 hero-check-item">
                                <i class="fa fa-check-circle"/>
                                <span>Cam kết chuẩn đầu ra văn bản</span>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-3">
                            <a href="/#test-online" class="tiw-btn-primary">
                                LÀM BÀI TEST NGAY <i class="fa fa-arrow-right"/>
                            </a>
                            <a href="/schedule" class="btn btn-outline-light rounded-pill px-4 py-2 fw-semibold">
                                Xem Lịch Khai Giảng
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

<section id="why-tiw" class="py-5 bg-white oe_snippet_body">
            <div class="container py-4">
                <div class="text-center max-w-3xl mx-auto mb-5">
                    <span class="tiw-badge-tag bg-warning bg-opacity-25 text-tiw-dark mb-2">Giá trị cốt lõi</span>
                    <h2 class="display-6 fw-bold text-tiw-dark">TẠI SAO CHỌN <span class="text-tiw-orange">THE IELTS WORKSHOP?</span></h2>
                    <div class="bg-warning mx-auto my-3 rounded" style="width: 60px; height: 4px;"/>
                    <p class="text-muted">Hơn 8 năm phát triển, đồng hành cùng hơn 50.000 học viên chinh phục mục tiêu IELTS.</p>
                </div>
                <div class="row g-5 align-items-center">
                    <div class="col-lg-6">
                        <div class="d-flex flex-column gap-4">
                            <div class="p-4 bg-light rounded-4 border d-flex gap-4">
                                <img src="/theme_theieltsworkshop/static/src/img/icon1.png" style="width: 48px; height: 48px;" alt="Icon"/>
                                <div>
                                    <h5 class="fw-bold mb-1">Đội ngũ giảng viên giỏi chuyên môn</h5>
                                    <p class="small text-muted mb-0">100% giáo viên tại TIW đều sở hữu 8.0 - 9.0 IELTS và chứng chỉ sư phạm quốc tế CELTA/TESOL.</p>
                                </div>
                            </div>
                            <div class="p-4 bg-light rounded-4 border d-flex gap-4">
                                <img src="/theme_theieltsworkshop/static/src/img/icon4.png" style="width: 48px; height: 48px;" alt="Icon"/>
                                <div>
                                    <h5 class="fw-bold mb-1">Chiến thuật học tập tinh gọn</h5>
                                    <p class="small text-muted mb-0">Lộ trình học cô đọng, bám sát cấu trúc đề thi thực tế, không quá tải mà vẫn tối ưu hóa thời gian.</p>
                                </div>
                            </div>
                            <div class="p-4 bg-light rounded-4 border d-flex gap-4">
                                <img src="/theme_theieltsworkshop/static/src/img/icon3.png" style="width: 48px; height: 48px;" alt="Icon"/>
                                <div>
                                    <h5 class="fw-bold mb-1">Mô hình LEARN – INQUIRE – MASTER (L.I.M)</h5>
                                    <p class="small text-muted mb-0">Phương pháp độc quyền kích thích tư duy ngôn ngữ chủ động, phản xạ tự nhiên.</p>
                                </div>
                            </div>
                            <div class="p-4 bg-light rounded-4 border d-flex gap-4">
                                <img src="/theme_theieltsworkshop/static/src/img/icon2.png" style="width: 48px; height: 48px;" alt="Icon"/>
                                <div>
                                    <h5 class="fw-bold mb-1">Môi trường tự chủ &amp; sáng tạo</h5>
                                    <p class="small text-muted mb-0">Không gian hiện đại, phòng tự học Study Space mở và thư viện phong phú.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="position-relative">
                            <div class="rounded-4 overflow-hidden shadow-lg border">
                                <img src="/theme_theieltsworkshop/static/src/img/tung-1.jpg" alt="Thầy Đặng Trần Tùng" class="img-fluid w-100" style="max-height: 520px; object-fit: cover;"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

<section id="courses" class="s_tiw_courses oe_snippet_body">
            <div class="container">
                <div class="text-center mb-5">
                    <span class="tiw-badge-tag bg-warning bg-opacity-25 text-tiw-dark mb-2">Lộ trình học bài bản</span>
                    <h2 class="display-6 fw-bold text-tiw-dark">CHỌN KHÓA HỌC <span class="text-tiw-orange">PHÙ HỢP NHẤT VỚI BẠN</span></h2>
                    <div class="bg-warning mx-auto my-3 rounded" style="width: 60px; height: 4px;"/>
                    <p class="text-muted">Hệ thống phân chia rõ ràng theo từng trình độ đầu vào giúp bạn tiến bộ vượt bậc.</p>
                </div>
                <div class="row g-4">
                    <!-- Card 1 -->
                    <div class="col-md-6 col-lg-3">
                        <div class="course-card">
                            <div>
                                <span class="badge bg-warning text-dark mb-3">Mất gốc tiếng Anh</span>
                                <h4 class="fw-bold text-tiw-dark">Freshman (0 - 2.5)</h4>
                                <p class="small text-muted">Xây dựng lại nền móng vững chắc, chuẩn hóa 44 âm ngữ âm IPA và 1.000 từ vựng cốt lõi.</p>
                                <ul class="small text-muted ps-3 mb-4">
                                    <li>Chuẩn hóa ngữ âm IPA</li>
                                    <li>Nắm chắc 12 thì cơ bản</li>
                                    <li>Thời lượng: 24 buổi (2 tháng)</li>
                                </ul>
                            </div>
                            <a href="/#register" class="tiw-btn-primary btn-sm w-100 text-decoration-none">Đăng ký tư vấn</a>
                        </div>
                    </div>
                    <!-- Card 2 -->
                    <div class="col-md-6 col-lg-3">
                        <div class="course-card">
                            <div>
                                <span class="badge bg-warning text-dark mb-3">Pre-IELTS</span>
                                <h4 class="fw-bold text-tiw-dark">Sophomore (2.5 - 4.5)</h4>
                                <p class="small text-muted">Làm quen cấu trúc 4 kỹ năng đề thi IELTS, rèn luyện kỹ năng Skimming, Scanning.</p>
                                <ul class="small text-muted ps-3 mb-4">
                                    <li>Format đề thi IELTS chuẩn</li>
                                    <li>Keywords Listening Part 1-2</li>
                                    <li>Thời lượng: 24 buổi (2 tháng)</li>
                                </ul>
                            </div>
                            <a href="/#register" class="tiw-btn-primary btn-sm w-100 text-decoration-none">Đăng ký tư vấn</a>
                        </div>
                    </div>
                    <!-- Card 3 -->
                    <div class="col-md-6 col-lg-3">
                        <div class="course-card border-warning">
                            <div>
                                <span class="badge bg-danger text-white mb-3">Phổ biến nhất</span>
                                <h4 class="fw-bold text-tiw-dark">Junior (4.5 - 5.5)</h4>
                                <p class="small text-muted">Phát triển tư duy phân tích đề bài, viết biểu đồ Task 1 và phản xạ Speaking Part 1 &amp; 2.</p>
                                <ul class="small text-muted ps-3 mb-4">
                                    <li>Chiến thuật xử lý mọi dạng đề</li>
                                    <li>Chấm chữa bài chi tiết 1:1</li>
                                    <li>Thời lượng: 28 buổi (2.5 tháng)</li>
                                </ul>
                            </div>
                            <a href="/#register" class="tiw-btn-primary btn-sm w-100 text-decoration-none">Đăng ký tư vấn</a>
                        </div>
                    </div>
                    <!-- Card 4 -->
                    <div class="col-md-6 col-lg-3">
                        <div class="course-card">
                            <div>
                                <span class="badge bg-dark text-warning mb-3">Về đích 7.5+</span>
                                <h4 class="fw-bold text-tiw-dark">Senior &amp; Master</h4>
                                <p class="small text-muted">Nâng cấp tư duy lập luận phản biện Part 3, làm chủ từ vựng C1-C2 Collocations &amp; Idioms.</p>
                                <ul class="small text-muted ps-3 mb-4">
                                    <li>Học cùng giáo viên 9.0</li>
                                    <li>Luyện áp lực thi thật</li>
                                    <li>Thời lượng: 32 buổi (3 tháng)</li>
                                </ul>
                            </div>
                            <a href="/#register" class="tiw-btn-primary btn-sm w-100 text-decoration-none">Đăng ký tư vấn</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

<section id="teachers" class="s_tiw_teachers oe_snippet_body">
            <div class="container">
                <div class="text-center mb-5">
                    <span class="tiw-badge-tag bg-warning bg-opacity-25 text-tiw-dark mb-2">Đội ngũ tinh hoa</span>
                    <h2 class="display-6 fw-bold text-tiw-dark">ĐỘI NGŨ <span class="text-tiw-orange">GIẢNG VIÊN 8.5 - 9.0 IELTS</span></h2>
                    <div class="bg-warning mx-auto my-3 rounded" style="width: 60px; height: 4px;"/>
                    <p class="text-muted">100% giáo viên tại TIW sở hữu chứng chỉ IELTS xuất sắc và bằng sư phạm quốc tế CELTA.</p>
                </div>
                <div class="row g-4">
                    <!-- Teacher 1 -->
                    <div class="col-lg-4 col-md-6">
                        <div class="teacher-card">
                            <div class="teacher-img-wrap">
                                <img src="/theme_theieltsworkshop/static/src/img/tung-1.jpg" alt="Đặng Trần Tùng"/>
                                <span class="teacher-score-badge"><i class="fa fa-trophy"/> 9.0 IELTS</span>
                            </div>
                            <div class="p-4">
                                <h5 class="fw-bold teacher-name mb-1">Thầy Đặng Trần Tùng</h5>
